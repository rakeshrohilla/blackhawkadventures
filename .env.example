# Postgres connection string (Neon, Supabase, RDS, or your own server)
DATABASE_URL="postgresql://user:password@host:5432/blackhawk?schema=public"

# Secret used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL of the site (used for canonical URLs and metadata)
NEXT_PUBLIC_SITE_URL="https://blackhawkadventures.com"

# Search engine visibility. The site is hidden from Google unless this is
# exactly "true", so a placeholder site can never be indexed by accident.
# Switch it on once the real content is in place, then redeploy.
SITE_INDEXABLE="false"

# Optional: seed these instead of the defaults when running `npm run db:seed`
ADMIN_EMAIL="admin@blackhawkadventures.com"
ADMIN_PASSWORD="change-this-immediately"
